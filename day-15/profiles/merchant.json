{
  "ucp": {
    "version": "2026-04-08",
    "services": {
      "dev.ucp.shopping": [
        {
          "version": "2026-04-08",
          "spec": "https://ucp.dev/latest/specification/overview/",
          "schema": "https://ucp.dev/2026-04-08/services/shopping/rest.openapi.json",
          "transport": "rest",
          "endpoint": "http://localhost:3000/ucp/v1"
        }
      ]
    },
    "capabilities": {
      "dev.ucp.shopping.checkout": [
        {
          "version": "2026-04-08",
          "spec": "https://ucp.dev/latest/specification/checkout/",
          "schema": "https://ucp.dev/2026-04-08/schemas/shopping/checkout.json"
        }
      ],
      "dev.ucp.shopping.fulfillment": [
        {
          "version": "2026-04-08",
          "spec": "https://ucp.dev/latest/specification/fulfillment/",
          "schema": "https://ucp.dev/2026-04-08/schemas/shopping/fulfillment.json",
          "extends": "dev.ucp.shopping.checkout"
        }
      ],
      "dev.ucp.shopping.discount": [
        {
          "version": "2026-04-08",
          "spec": "https://ucp.dev/latest/specification/discount/",
          "schema": "https://ucp.dev/2026-04-08/schemas/shopping/discount.json",
          "extends": ["dev.ucp.shopping.checkout", "dev.ucp.shopping.cart"]
        }
      ],
      "dev.ucp.shopping.catalog": [
        {
          "version": "2026-04-08",
          "spec": "https://ucp.dev/latest/specification/catalog/",
          "schema": "https://ucp.dev/2026-04-08/schemas/shopping/catalog.json"
        }
      ],
      "dev.ucp.shopping.identity_linking": [
        {
          "version": "2026-04-08",
          "spec": "https://ucp.dev/latest/specification/identity-linking/",
          "schema": "https://ucp.dev/2026-04-08/schemas/shopping/identity-linking.json"
        }
      ],
      "dev.ucp.shopping.discount": [
        {
          "version": "2026-04-08",
          "spec": "https://ucp.dev/latest/specification/discount/",
          "extends": ["dev.ucp.shopping.checkout", "dev.ucp.shopping.cart"]
        }
      ]
    },
    "payment_handlers": {
      "com.google.pay": [
        {
          "id": "gpay_handler_1",
          "version": "2026-04-08",
          "spec": "https://developers.google.com/merchant/ucp/guides/gpay-payment-handler",
          "available_instruments": [
            {
              "type": "card",
              "constraints": { "brands": ["visa", "mastercard", "amex"] }
            }
          ],
          "config": {
            "environment": "TEST",
            "merchant_info": {
              "merchant_name": "UCP Demo Merchant",
              "merchant_id": "demo-merchant-01"
            }
          }
        }
      ]
    }
  },
  "signing_keys": [
    {
      "kid": "day12-key-1",
      "kty": "EC",
      "crv": "P-256",
      "alg": "ES256",
      "use": "sig",
      "x":   "aX5BRO5gQRLsPpK5OsRFItbCJcKmvLgI9D__KtA3cgk",
      "y":   "J96RdZOBO22n0gBzruVIpjq_q4-cpFNBMu4JOYDLonk"
    }
  ]
}
